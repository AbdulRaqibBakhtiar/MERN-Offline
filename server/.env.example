NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=https://your-bazzar-domain.example
CLIENT_APP_URL=https://your-bazzar-domain.example
TRUST_PROXY=true

# Password recovery email (Resend). Recovery remains disabled until these are set.
RESEND_API_KEY=re_<secret>
AUTH_EMAIL_FROM=Bazzar <no-reply@your-verified-domain.example>

# Coturn REST credentials. TURN_SHARED_SECRET must match coturn static-auth-secret.
# Use short-lived credentials; never put the shared secret in the React client.
TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-the-coturn-shared-secret

ADMIN_USERNAMES=
EDITOR_USERNAMES=
AUTHOR_USERNAMES=
